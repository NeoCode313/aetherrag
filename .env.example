# Referencia de desarrollo. Para Compose genera .env mediante:
# python backend/scripts/setup_env.py
# El asistente genera secretos únicos y hash Argon2, sin sobrescribir .env.
ENVIRONMENT=development
DATA_DIR=./data
LOG_LEVEL=INFO
LLM_PROVIDER=local
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=768
VECTOR_BACKEND=embedded
QUEUE_BACKEND=background
DATABASE_URL=
AUTO_SEED_SAMPLE_MANUAL=false
PIPELINE_VERSION=layout-v3

# Desarrollo monoproceso: enlaza Uvicorn solo a 127.0.0.1.
# Compose impone autenticación y cookies seguras en producción.
AUTH_ENABLED=false
SESSION_SECURE=false
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_SECONDS=28800

# Obligatorios para Compose; setup_env.py genera los valores privados.
DB_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=multimodal_technical_chunks
REDIS_URL=redis://localhost:6379/0

# Opcionales. Los nombres dependen de tu endpoint/cuenta; no garantizan disponibilidad.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
GROQ_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_SUPPORTS_IMAGES=false
PROVIDER_ALLOWED_HOSTS=["api.openai.com","api.groq.com","localhost","127.0.0.1","ollama"]
PROVIDER_TIMEOUT_SECONDS=45

MAX_UPLOAD_MB=50
MAX_PENDING_JOBS=1000
JOB_LEASE_SECONDS=180
DISPATCHER_INTERVAL_SECONDS=2
# Presupuesto conservador de bytes UTF-8, incluido breadcrumb; no tokens reales.
CHUNK_MAX_TOKENS=1800
CHUNK_OVERLAP_RATIO=0.15
SPATIAL_MAX_DISTANCE=0.38
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_POOL=16
MIN_DENSE_SCORE=0.20
RRF_K=60
DENSE_WEIGHT=0.65
SPARSE_WEIGHT=0.35
ATTACH_IMAGES_TO_LLM=true

OCR_ENABLED=false
OCR_LANGUAGE=eng
PDF_MAX_PAGES=500
PDF_MAX_PARSE_SECONDS=120
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.6
RETRY_MAX_DELAY_SECONDS=6
CIRCUIT_BREAKER_FAILURE_THRESHOLD=4
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# Optional host HTTPS port; internal proxy remains on 8443.
APP_HTTPS_PORT=8443
